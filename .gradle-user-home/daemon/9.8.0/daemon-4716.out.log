      @Override public boolean onCommand(@NotNull CommandSender s, @NotNull Command c, @NotNull String l, String @NotNull [] a) { if (!(s instanceof Player p)) return true; String sub = a.length == 0 ? "info" : a[0].toLowerCase(Locale.ROOT); Guild own = guild(p); switch (sub) { case "create" -> { if (own != null || a.length < 2) { p.sendMessage(Text.mm("<red>Usage: /guild create <name> (you must not already belong to one)")); return true; } String name = a[1]; if (name.length() < 3 || name.length() > 16 || find(name) != null) { p.sendMessage(Text.mm("<red>That guild name is unavailable.")); return true; } Set<UUID> members = new HashSet<>(); members.add(p.getUniqueId()); guilds.put(name.toLowerCase(Locale.ROOT), new Guild(name, p.getUniqueId(), members, 0)); save(); p.sendMessage(Text.mm("<green>Guild created: <aqua>" + name)); } case "invite" -> { if (own == null || !own.owner.equals(p.getUniqueId()) || a.length < 2) { p.sendMessage(Text.mm("<red>Only the guild owner can invite players.")); return true; } Player target = Bukkit.getPlayerExact(a[1]); if (target == null) { p.sendMessage(Text.mm("<red>That player is not online.")); return true; } invites.put(target.getUniqueId(), own.name); target.sendMessage(Text.mm("<aqua>You were invited to <white>" + own.name + "</white>. Use <yellow>/guild join " + own.name)); } case "join" -> { if (own != null || a.length < 2 || !ownInvite(p, a[1])) { p.sendMessage(Text.mm("<red>You need a valid guild invitation.")); return true; } Guild target = find(a[1]); target.members.add(p.getUniqueId()); invites.remove(p.getUniqueId()); save(); p.sendMessage(Text.mm("<green>You joined <aqua>" + target.name)); } case "leave" -> { if (own == null) return true; own.members.remove(p.getUniqueId()); if (own.members.isEmpty() || own.owner.equals(p.getUniqueId())) guilds.remove(own.name.toLowerCase(Locale.ROOT)); save(); p.sendMessage(Text.mm("<gray>You left your guild.")); } case "contribute" -> { if (own == null) { p.sendMessage(Text.mm("<red>Join a guild first.")); return true; } own.points += 10; save(); p.sendMessage(Text.mm("<green>Guild contribution added. Level: " + level(own))); } default -> open(p); } return true; }
